  "source": "SAVED_REPORTS",
  "sourceSchema": "workcube_mikrolink",
  "schemaMode": "standard",
  "sourceQuery": "SELECT SR.SR_ID, SR.REPORT_ID, COALESCE(R.REPORT_NAME, SR.REPORT_NAME) AS REPORT_NAME, COALESCE(SR.REPORT_DETAIL, R.REPORT_DETAIL) AS REPORT_DETAIL, SR.FILE_NAME, SR.FILE_SERVER_ID, SR.RECORD_DATE, SR.RECORD_EMP, SR.UPDATE_DATE, SR.UPDATE_EMP FROM [workcube_mikrolink].[SAVED_REPORTS] SR WITH (NOLOCK) LEFT JOIN [workcube_mikrolink].[REPORTS] R WITH (NOLOCK) ON R.REPORT_ID = SR.REPORT_ID",
